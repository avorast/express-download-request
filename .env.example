# Settings for requesting the bundled checklist by email.
# Save local values in .env. Real tokens and passwords belong outside source control.
# To preview messages locally, run the dev server with MAIL_MODE=log. Sending setup is in docs/email-setup.md.

APP_URL=http://localhost:3000 # Use a reachable origin: the one-time download links point back to this app.
HOST=127.0.0.1 # Network interface for the server; 127.0.0.1 is the local loopback address.
PORT=3000 # Production port number. A reverse proxy may expose a different public port.
DB_PATH=.data/app.sqlite # Download requests, expiring access tokens, and link emails; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # To inspect download requests, use username admin with your own random password (minimum 16 characters).
OWNER_EMAIL=owner@example.com # Not used for download links; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # Optional to clear: download links are routed without this reviewer setting.
MAIL_MODE=sandbox # Choose sandbox to inspect download links, production to send, or log for a development preview.
MAIL_FROM=sender@example.com # Use your verified Mailtrap domain for the production sender of download links.
MAILTRAP_PRODUCTION_TOKEN= # Your Mailtrap transactional send token for download links; leave empty for sandbox or log mode.
MAILTRAP_SANDBOX_TOKEN= # API token with access to the Sandbox used for download request messages.
MAILTRAP_INBOX_ID= # Numeric Sandbox ID from its API integration settings; captured download email stays here.
